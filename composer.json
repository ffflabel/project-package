{
  "name": "ffflabel/project",
  "type": "project",
  "license": "MIT",
  "description": "WordPress boilerplate with modern development tools, easier configuration, and an improved folder structure",
  "homepage": "https://ffflabel.com/",
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "composer/installers": true,
      "roots/wordpress-core-installer": true
    }
  },
  "autoload": {
    "psr-4": {
      "FFFlabelChild\\": "web/app/themes/ffflabel-child"
    }
  },
  "repositories": [
    { "type":"git", "url":"https://github.com/woocommerce/storefront.git" },
    { "type":"vcs", "url":"https://github.com/ffflabel/wptheme.git" },
    { "type": "vcs", "url": "https://github.com/ffflabel/services.git" },
    { "type": "composer", "url": "https://wpackagist.org", "only": ["wpackagist-plugin/*", "wpackagist-theme/*"] },
    { "type": "composer", "url": "https://connect.advancedcustomfields.com" }
  ],
  "require": {

    "php": ">=8.1",
    "composer/installers": "^2.2",
    "vlucas/phpdotenv": "^5.5",
    "oscarotero/env": "^2.1",

    "roots/bedrock-autoloader": "^1.0",
    "roots/bedrock-disallow-indexing": "^2.0",
    "roots/wp-config": "1.0.0",

    "roots/wordpress": "6.8.1",

    "ffflabel/ffflabel": "^v0.1.0",
    "ffflabel/services" : "^0.1.6",

    "wpengine/advanced-custom-fields-pro": "^6.4.0.1",

  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.0.2",
    "roave/security-advisories": "dev-master@dev"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "installer-paths": {
      "web/app/mu-plugins/{$name}/": ["type:wordpress-muplugin"],
      "web/app/plugins/{$name}/": ["type:wordpress-plugin"],
      "web/app/themes/{$name}/": ["type:wordpress-theme"]
    },
    "wordpress-install-dir": "web/wp"
  },
  "scripts": {
    "post-root-package-install": [
      "php -r \"copy('.env.example', '.env');\"",
      "php -r \"rename('.github_example', '.github');\"",
      "php -r \"rename('auth.example.json', 'auth.json');\""
    ],
    "test": [
      "phpcs"
    ]
  }
}
